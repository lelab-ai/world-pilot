{
  "name": "worldpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:golden": "tsx src/tests/golden.test.ts",
    "generate:library": "node --import tsx scripts/generate-library.ts",
    "test:library": "node --import tsx src/tests/library.test.ts",
    "test:audit": "node --import tsx src/tests/experienceAudit.test.ts",
    "test:observability": "node --import tsx src/tests/causalObservability.test.ts",
    "test:pillars": "node --import tsx src/tests/fourPillarsHandsOn.test.ts",
    "test:dataset": "node scripts/validate_worldpilot_dataset.mjs",
    "verify": "npm run test:golden && npm run test:observability && npm run test:pillars && npm run test:library && npm run test:audit && npm run test:dataset && npm run build",
    "research:edit-order:benchmark": "node --import tsx scripts/research/benchmark.ts --version v1 --snapshot current",
    "research:paper": "npm run research:v2:paper",
    "research:replay": "node --import tsx scripts/research/benchmark.ts --version v1 --action replay",
    "research:v2:benchmark": "node --import tsx scripts/research/benchmark.ts --version v2 --snapshot current",
    "research:v2:paper": "node --import tsx scripts/research/benchmark.ts --version v2 --snapshot paper",
    "research:v2:replay": "node --import tsx scripts/research/benchmark.ts --version v2 --action replay"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@react-three/drei": "^9.106.0",
    "@react-three/fiber": "^8.16.8",
    "@react-three/rapier": "^2.2.0",
    "@react-three/xr": "^6.6.30",
    "@use-gesture/react": "^10.3.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "three": "^0.165.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
